# PrintFree — Apache configuration
Options -Indexes
DirectoryIndex public/index.php

# The server's default 2 MB/8 MB PHP limits are too small for photo uploads.
# The app itself still caps each photo at MAX_UPLOAD_MB (10 MB).
<IfModule lsapi_module>
    php_value upload_max_filesize 12M
    php_value post_max_size 128M
</IfModule>

# Application-only folders: block every direct request to them. The cron
# worker is CLI-only and also refuses to run over HTTP.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^includes(?:/|$) - [F,L,NC]
    RewriteRule ^cron(?:/|$) - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Never serve raw database dumps or dotfiles.
<FilesMatch "\.(sql|sqlite|log|md)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
